{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "nome",
    "serial",
    "localizacao"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "serial": {
      "type": "string",
      "minLength": 1
    },
    "localizacao": {
      "type": "string",
      "minLength": 1
    }
  }
}
