{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "status",
    "errors"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": 400
    },
    "errors": {
      "type": "object",
      "required": [
        "LitrosConsumidos"
      ],
      "properties": {
        "LitrosConsumidos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
