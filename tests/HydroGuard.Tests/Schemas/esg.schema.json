{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "consumoMensal",
    "consumoMedioDiario",
    "desperdicioEstimado",
    "aguaEconomizada",
    "scoreESG"
  ],
  "properties": {
    "consumoMensal": {
      "type": "number",
      "minimum": 0
    },
    "consumoMedioDiario": {
      "type": "number",
      "minimum": 0
    },
    "desperdicioEstimado": {
      "type": "number",
      "minimum": 0
    },
    "aguaEconomizada": {
      "type": "number",
      "minimum": 0
    },
    "scoreESG": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
