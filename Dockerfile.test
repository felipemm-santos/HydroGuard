FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /workspace
COPY src/HydroGuard.API/HydroGuard.API.csproj src/HydroGuard.API/
COPY tests/HydroGuard.Tests/HydroGuard.Tests.csproj tests/HydroGuard.Tests/
RUN dotnet restore tests/HydroGuard.Tests/HydroGuard.Tests.csproj
COPY src/HydroGuard.API/ src/HydroGuard.API/
COPY tests/HydroGuard.Tests/ tests/HydroGuard.Tests/
CMD ["dotnet", "test", "tests/HydroGuard.Tests/HydroGuard.Tests.csproj", "-c", "Release", "--no-restore", "--logger", "console;verbosity=normal"]
